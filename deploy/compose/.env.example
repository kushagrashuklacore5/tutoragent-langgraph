# Values for deploy/docker-compose.yml (local development stack). Never commit the filled-in copy.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
SYSTEM_DB_PASSWORD=
PLATFORM_MASTER_KEY=
# optional: local OpenTelemetry collector, e.g. http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

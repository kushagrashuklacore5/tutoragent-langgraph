# Copy to .env for local development. Never commit real values.
PLATFORM_ENV=development
# owner role: runs migrations and module purge
DATABASE_URL=postgres://platform_owner@127.0.0.1:54329/ekbharat
# runtime role without BYPASSRLS (all request handling)
APP_DATABASE_URL=postgres://platform_app@127.0.0.1:54329/ekbharat
# privileged role for sign-in lookups, the job claimer and gateway config
SYSTEM_DATABASE_URL=postgres://platform_system@127.0.0.1:54329/ekbharat
# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
PLATFORM_MASTER_KEY=
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# AI provider keys are NOT configured here: add connections through the admin API
# (they are envelope-encrypted in the database and never readable back).
